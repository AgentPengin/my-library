<%- include('../partials/header', { title: 'Giá Sách Của Tôi - Alexandria Archive' }) %>
<%- include('../partials/navbar', { currentRoute: 'shelves' }) %>

<main class="main-wall">
  
  <!-- USER LIBRARY BADGE & CONTROLS -->
  <% if (typeof currentUser !== 'undefined' && currentUser) { %>
    <div class="vintage-card" style="margin-bottom: 35px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 20px;">
      <div style="display: flex; gap: 20px; align-items: center;">
        <img src="<%= currentUser.avatar_url %>" alt="avatar" style="width: 70px; height: 70px; border-radius: 6px; border: 2px solid #5a3a1f; box-shadow: 0 4px 10px rgba(0,0,0,0.4); object-fit: cover;">
        <div>
          <div class="library-stamp" style="font-size: 10px; margin-bottom: 4px;">CHỦ NHÂN KHO SÁCH</div>
          <h2 style="font-family: 'Cinzel', serif; font-size: 22px; color: #2e1706;"><%= currentUser.username %></h2>
          <p style="font-size: 14px; color: #644933; font-style: italic;"><%= currentUser.bio %></p>
          <div style="font-size: 12px; color: #876d54; margin-top: 4px;">
            Số Thẻ Độc Giả: <strong><%= currentUser.library_card_no %></strong> • Gia nhập: <%= currentUser.member_since %>
          </div>
        </div>
      </div>

      <div>
        <button class="btn-skeuo btn-brass" onclick="document.getElementById('newShelfBox').style.display = document.getElementById('newShelfBox').style.display === 'none' ? 'block' : 'none'">
          ✦ Đóng Kệ Sách Mới
        </button>
      </div>
    </div>
  <% } else { %>
    <div class="vintage-card" style="margin-bottom: 35px; text-align: center; padding: 25px;">
      <div class="library-stamp" style="margin-bottom: 8px;">KHÁCH VÃNG LAI</div>
      <h2 style="font-family: 'Cinzel', serif; font-size: 22px; color: #2e1706; margin-bottom: 8px;">
        Chào Mừng Bạn Đến Với Thư Viện
      </h2>
      <p style="font-size: 15px; color: #5a3a1f; max-width: 650px; margin: 0 auto 16px;">
        Bạn đang chiêm ngưỡng các giá sách mẫu của thư viện. Hãy đăng nhập hoặc đăng ký thẻ độc giả mới để bắt đầu tạo các giá sách của riêng mình!
      </p>
      <div style="display: flex; gap: 12px; justify-content: center;">
        <a href="/login" class="btn-skeuo">🔑 Đăng Nhập Ngay</a>
        <a href="/register" class="btn-skeuo btn-brass">✦ Đăng Ký Thẻ Mới</a>
      </div>
    </div>
  <% } %>

  <!-- COLLAPSIBLE FORM: CREATE NEW SHELF -->
  <div id="newShelfBox" class="vintage-card" style="display: none; margin-bottom: 35px; border-left: 6px solid #8a4b27;">
    <h3 style="font-family: 'Cinzel', serif; font-size: 18px; color: #321908; margin-bottom: 12px;">
      ✦ Chế Tác Kệ Sách Mới (Tạo Bảng Shelves trong PostgreSQL)
    </h3>
    <form action="/shelves/create" method="POST">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; margin-bottom: 16px;">
        <div>
          <label style="display: block; font-size: 13px; font-weight: 700; margin-bottom: 4px;">Tên Giá Sách:</label>
          <input type="text" name="name" class="input-skeuo" placeholder="Vd: Sách Triết Học Mùa Đông..." required>
        </div>
        <div>
          <label style="display: block; font-size: 13px; font-weight: 700; margin-bottom: 4px;">Chất Liệu Gỗ (shelf_wood):</label>
          <select name="shelf_wood" class="input-skeuo">
            <option value="oak">Gỗ Sồi Cổ (Oak Wood - Vàng Ấm)</option>
            <option value="mahogany">Gỗ Gụ Hoàng Gia (Mahogany - Đỏ Nâu Quý Phái)</option>
            <option value="walnut">Gỗ Óc Chó (Walnut - Nâu Đậm Trầm Mặc)</option>
          </select>
        </div>
        <div>
          <label style="display: block; font-size: 13px; font-weight: 700; margin-bottom: 4px;">Quyền Riêng Tư (is_public):</label>
          <select name="is_public" class="input-skeuo">
            <option value="true">Công Khai (Mọi người có thể chiêm ngưỡng)</option>
            <option value="false">Riêng Tư (Chỉ riêng bạn)</option>
          </select>
        </div>
      </div>
      <div style="margin-bottom: 16px;">
        <label style="display: block; font-size: 13px; font-weight: 700; margin-bottom: 4px;">Lời Đề Từ / Mô Tả Kệ:</label>
        <textarea name="description" class="input-skeuo" rows="2" placeholder="Ghi chú vài dòng về lý do bạn gom các tác phẩm này lại với nhau..."></textarea>
      </div>
      <div style="text-align: right;">
        <button type="submit" class="btn-skeuo btn-brass">✦ Đóng Kệ & Lưu Vào CSDL</button>
      </div>
    </form>
  </div>

  <!-- LOOP ALL USER'S SHELVES -->
  <% shelves.forEach((shelf, index) => { %>
    <div style="margin-bottom: 45px;">
      
      <!-- Brass Header for Each Shelf -->
      <div class="section-head-bar">
        <div class="brass-plate">
          <h2>
            <%= shelf.name %> 
            <span style="font-size: 13px; font-weight: 400; opacity: 0.85;">
              (<%= shelf.items.length %> tác phẩm • <%= shelf.shelf_wood === 'oak' ? 'Gỗ Sồi' : (shelf.shelf_wood === 'mahogany' ? 'Gỗ Gụ' : 'Gỗ Óc Chó') %>)
            </span>
          </h2>
        </div>

        <div style="display: flex; gap: 10px; align-items: center;">
          <span style="font-size: 12px; color: #c4ab8e;">
            <%= shelf.is_public ? '🌍 Kệ Công Khai' : '🔒 Kệ Riêng Tư' %>
          </span>
          <a href="/shelves/<%= shelf.id %>" class="btn-skeuo">
            📖 Quản Lý Kệ Này
          </a>
        </div>
      </div>

      <!-- Description of Shelf -->
      <% if (shelf.description) { %>
        <p style="font-size: 15px; color: #a89178; margin-top: -12px; margin-bottom: 14px; font-style: italic;">
          "<%= shelf.description %>"
        </p>
      <% } %>

      <!-- The 3D Bookshelf Unit (with dynamic wood class) -->
      <div class="bookshelf-unit wood-<%= shelf.shelf_wood %>">
        <%- include('../partials/shelf-row', { items: shelf.items }) %>
      </div>

    </div>
  <% }) %>

</main>

<%- include('../partials/footer') %>
