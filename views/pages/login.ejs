<%- include('../partials/header', { title: 'Đăng Nhập Thẻ Độc Giả - Alexandria Archive' }) %>
<%- include('../partials/navbar', { currentRoute: 'login' }) %>

<main class="main-wall" style="max-width: 540px; margin-top: 30px;">

  <div class="vintage-card" style="border: 4px solid #5a381e; box-shadow: 0 20px 45px rgba(0,0,0,0.9);">
    
    <div style="text-align: center; margin-bottom: 24px;">
      <div class="library-stamp" style="font-size: 11px; margin-bottom: 8px;">XÁC NHẬN NGƯỜI DÙNG</div>
      <h1 style="font-family: 'Playfair Display', Georgia, serif; font-size: 24px; color: #2e1706; letter-spacing: 1px;">
        Đăng Nhập
      </h1>
      <p style="font-size: 14px; color: #6b4d32; font-style: italic; margin-top: 4px;">
        Nhập tài khoản và mật khẩu của bạn để mở cửa kho lưu trữ sách và phim cá nhân.
      </p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="skeuo-error-alert">
        <div style="display: flex; align-items: center; justify-content: center; gap: 8px; margin-bottom: 4px;">
          <span class="library-stamp" style="font-size: 10px; padding: 2px 8px; transform: rotate(-2deg); background: rgba(147, 36, 36, 0.08);">
            ✕ TỪ CHỐI TRUY CẬP
          </span>
        </div>
        <div style="font-size: 14px; font-weight: 700; color: #8a1d1d; text-shadow: 0 1px 0 rgba(255,255,255,0.6);">
          <%= error %>
        </div>
        <div style="font-size: 12px; color: #6e3c3c; margin-top: 3px; font-style: italic;">
          Vui lòng kiểm tra lại phím Caps Lock hoặc tên đăng nhập/mật khẩu của bạn.
        </div>
      </div>
    <% } %>

    <form action="/auth/login" method="POST">
      <div style="margin-bottom: 18px;">
        <label style="display: block; font-size: 14px; font-weight: 700; color: #3b220d; margin-bottom: 6px;">
          Email Hoặc Tên Người dùng:
        </label>
        <input 
          type="text" 
          name="identifier" 
          class="input-skeuo" 
          placeholder="scholar@library.antique hoặc alexandria_scholar"
          value="<%= typeof identifier !== 'undefined' ? identifier : '' %>"
          required
        >
      </div>

      <div style="margin-bottom: 22px;">
        <label style="display: block; font-size: 14px; font-weight: 700; color: #3b220d; margin-bottom: 6px;">
          Mật Khẩu (Password):
        </label>
        <input 
          type="password" 
          name="password" 
          class="input-skeuo" 
          placeholder="••••••••••••"
          value="vintage123"
          required
        >
      </div>

      <div style="margin-bottom: 24px; display: flex; justify-content: space-between; align-items: center; font-size: 13px;">
        <label style="display: flex; align-items: center; gap: 6px; cursor: pointer; color: #5a381c;">
          <input type="checkbox" name="remember" checked> Ghi nhớ trên thiết bị này
        </label>
        <a href="#" style="color: #8c381c; text-decoration: underline;">Quên mật khẩu?</a>
      </div>

      <button type="submit" class="btn-skeuo btn-brass" style="width: 100%; justify-content: center; padding: 12px; font-size: 15px;">
        Đăng nhập
      </button>
    </form>

    <div style="margin-top: 24px; border-top: 1px dashed #d1c09e; padding-top: 16px; text-align: center; font-size: 14px; color: #6b4d32;">
      Chưa đăng ký? 
      <a href="/register" style="font-weight: 700; color: #2e1706; text-decoration: underline;">
        Đăng ký ngay
      </a>
    </div>

  </div>

</main>

<%- include('../partials/footer') %>
