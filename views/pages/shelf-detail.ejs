<%- include('../partials/header', { title: shelf.name + ' - Alexandria Archive' }) %>
<%- include('../partials/navbar', { currentRoute: 'shelves' }) %>

<main class="main-wall">
  
  <!-- BACK NAVIGATION -->
  <div style="margin-bottom: 20px;">
    <a href="/shelves" class="btn-skeuo" style="font-size: 12px; padding: 5px 12px;">
      ◀ Quay lại Tất Cả Giá Sách
    </a>
  </div>

  <!-- SHELF HEADER BRASS & INFO -->
  <div class="vintage-card" style="margin-bottom: 30px;">
    <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 15px;">
      <div>
        <div style="display: flex; gap: 10px; align-items: center; margin-bottom: 6px;">
          <span class="library-stamp" style="font-size: 10px;">
            <%= shelf.is_public ? '🌍 GIÁ SÁCH CÔNG KHAI' : '🔒 GIÁ SÁCH RIÊNG TƯ' %>
          </span>
          <% if (typeof isOwner !== 'undefined' && !isOwner) { %>
            <span style="font-size: 13px; color: #6f4728; font-style: italic;">
              Tuyển chọn bởi: <strong style="color: #3b1e0a;"><%= shelf.owner ? shelf.owner.username : 'Người dùng' %></strong>
            </span>
          <% } %>
        </div>

        <h1 style="font-family: 'Playfair Display', Georgia, serif; font-size: 26px; color: #2e1706; margin-bottom: 8px;">
          <%= shelf.name %>
        </h1>
        <p style="font-size: 16px; color: #523824; font-style: italic; max-width: 750px; line-height: 1.6;">
          <%= shelf.description || 'Chưa có lời tựa cho giá sách này.' %>
        </p>
        
        <div style="margin-top: 14px; display: flex; gap: 16px; font-size: 13px; color: #7a5f45; border-top: 1px dashed #d6c6a4; padding-top: 10px; flex-wrap: wrap;">
          <span>Chất liệu: <strong><%= shelf.shelf_wood === 'oak' ? 'Gỗ Sồi Cổ (Oak)' : (shelf.shelf_wood === 'mahogany' ? 'Gỗ Gụ Hoàng Gia' : 'Gỗ Óc Chó') %></strong></span>
          <span>Số lượng: <strong><%= shelf.items.length %> tác phẩm</strong></span>
          <span>Lượt thích: <strong><%= shelf.likes_count || 0 %> ❤️</strong></span>
          <span>Khởi tạo: <strong><%= shelf.created_at ? new Date(shelf.created_at).toLocaleDateString('vi-VN') : '' %></strong></span>
        </div>
      </div>

      <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
        <!-- NÚT SAO CHÉP LINK CÔNG KHAI (NẾU KỆ PUBLIC) -->
        <% if (shelf.is_public) { %>
          <button type="button" class="btn-skeuo" onclick="copyShelfLink()" style="font-size: 12px; padding: 7px 14px;">
            🔗 Chia Sẻ Kệ Sách
          </button>
        <% } %>

        <% if (typeof isOwner !== 'undefined' && isOwner) { %>
          <!-- NÚT MỞ MODAL THÊM SÁCH/PHIM TRỰC TIẾP -->
          <button type="button" class="btn-skeuo btn-brass" onclick="openAddMediaModal()">
            Thêm Sách / Phim Vào Kệ
          </button>

          <!-- NÚT XÓA TOÀN BỘ GIÁ SÁCH NÀY -->
          <form action="/shelves/<%= shelf.id %>/delete" method="POST" style="margin: 0; display: inline;" onsubmit="return confirm('⚠️ BẠN CÓ CHẮC CHẮN MUỐN XÓA GIÁ SÁCH NÀY?\n\nToàn bộ giá sách [<%= shelf.name %>] và các liên kết tác phẩm trên kệ sẽ bị dỡ bỏ. Hành động này không thể hoàn tác!');">
            <button type="submit" class="btn-skeuo btn-ruby">
              Xóa Giá Sách Này
            </button>
          </form>
        <% } else { %>
          <!-- Nút yêu thích giá sách -->
          <form action="/shelves/<%= shelf.id %>/like" method="POST" style="margin: 0; display: inline;">
            <button type="submit" class="btn-skeuo <%= shelf.is_liked_by_me ? 'btn-ruby' : 'btn-brass' %>" style="font-size: 13px; padding: 8px 16px;">
              <%= shelf.is_liked_by_me ? '❤️ Đã Thích Kệ' : '🤍 Yêu Thích Kệ Này' %> (<%= shelf.likes_count || 0 %>)
            </button>
          </form>
        <% } %>
      </div>
    </div>
  </div>

  <!-- VIEW MODE SWITCH -->
  <div class="section-head-bar">
    <div class="brass-plate">
      <h2>Tác Phẩm Đang Trưng Bày Trên Kệ</h2>
    </div>

    <div class="segmented-control">
      <button class="segmented-tab active" onclick="switchShelfView('3d', this)">
        🪵 Chế Độ Kệ Gỗ 3D
      </button>
      <button class="segmented-tab" onclick="switchShelfView('table', this)">
        📋 Chế độ danh sách
      </button>
    </div>
  </div>

  <!-- 3D WOODEN SHELF VIEW (ĐA TẦNG KỆ GỖ 3D) -->
  <div id="view3D" class="bookshelf-unit wood-<%= shelf.shelf_wood %>">
    <%- include('../partials/shelf-row', { 
      items: shelf.items, 
      currentShelfId: shelf.id, 
      currentShelfOwnerId: shelf.user_id,
      isOwner: (typeof isOwner !== 'undefined' ? Boolean(isOwner) : false)
    }) %>
  </div>

  <!-- VINTAGE TABLE CATALOG VIEW -->
  <div id="viewTable" class="vintage-card" style="display: none; padding: 15px; overflow-x: auto;">
    <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 15px;">
      <thead>
        <tr style="border-bottom: 2px solid #8e6843; color: #3b220d; font-family: 'Playfair Display', Georgia, serif;">
          <th style="padding: 10px 8px;">Bìa</th>
          <th style="padding: 10px 8px;">Tên Tác Phẩm</th>
          <th style="padding: 10px 8px;">Tác Giả / Đạo Diễn</th>
          <th style="padding: 10px 8px;">Loại</th>
          <th style="padding: 10px 8px;">Đánh Giá Chủ Kệ</th>
          <th style="padding: 10px 8px;">Năm</th>
          <% if (typeof isOwner !== 'undefined' && isOwner) { %>
            <th style="padding: 10px 8px; text-align: right;">Hành Động</th>
          <% } %>
        </tr>
      </thead>
      <tbody>
        <% shelf.items.forEach(item => { %>
          <tr style="border-bottom: 1px dashed #d8caa7;">
            <td style="padding: 8px;">
              <img src="<%= item.poster_url %>" alt="" style="width: 40px; height: 55px; object-fit: cover; border-radius: 2px; border: 1px solid #6b4728;">
            </td>
            <td style="padding: 8px; font-weight: 700; color: #2e1706;">
              <a href="/<%= item.media_type === 'BOOK' ? 'books' : 'movies' %>/<%= item.id %>?curator=<%= shelf.user_id %>&from_shelf=<%= shelf.id %>" style="text-decoration: underline;">
                <%= item.title %>
              </a>
              <% if (item.owner_review_snippet) { %>
                <div style="font-size: 12px; color: #7f5533; font-style: italic; font-weight: normal; margin-top: 2px;">
                  "<%= item.owner_review_snippet %>"
                </div>
              <% } %>
            </td>
            <td style="padding: 8px; color: #5a3d24;"><%= item.creator %></td>
            <td style="padding: 8px;">
              <span class="media-tag <%= item.media_type === 'MOVIE' ? 'movie' : '' %>" style="position: static; display: inline-block;">
                <%= item.media_type === 'BOOK' ? 'SÁCH' : 'PHIM' %>
              </span>
            </td>
            <td style="padding: 8px;">
              <% if (item.owner_rating) { %>
                <span style="color: #b8860b; font-weight: 700; font-size: 14px;">★ <%= item.owner_rating %>/5.0</span>
              <% } else { %>
                <span style="color: #a0866b; font-size: 12px; font-style: italic;">Chưa chấm</span>
              <% } %>
            </td>
            <td style="padding: 8px; color: #7a5f45;"><%= item.release_year %></td>
            
            <% if (typeof isOwner !== 'undefined' && isOwner) { %>
              <td style="padding: 8px; text-align: right;">
                <form action="/shelves/<%= shelf.id %>/remove-item" method="POST" style="display: inline;" onsubmit="return confirm('Bạn có chắc muốn gỡ tác phẩm [<%= item.title %>] khỏi giá sách?');">
                  <input type="hidden" name="media_id" value="<%= item.id %>">
                  <button type="submit" class="btn-skeuo btn-ruby" style="font-size: 11px; padding: 3px 8px;">
                    Gỡ Khỏi Kệ
                  </button>
                </form>
              </td>
            <% } %>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

</main>

<% if (typeof isOwner === 'undefined' || isOwner) { %>
  <div class="modal-overlay" id="addMediaToShelfModal">
    <div class="modal-box" style="max-width: 620px; max-height: 88vh; overflow-y: auto;">
      <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px;">
        <div>
          <h3 style="font-family: 'Playfair Display', Georgia, serif; font-size: 19px; color: #2c1608;">THÊM SÁCH/PHIM VÀO KỆ: <%= shelf.name %></h3>
        </div>
        <button type="button" class="btn-skeuo" onclick="closeAddMediaModal()" style="padding: 4px 10px; font-size: 12px;">Đóng</button>
      </div>

      <!-- TAB SWITCHER -->

      <!-- TAB 1: TÌM KIẾM TRỰC TIẾP -->
      <div id="tabSearchSection">
        <form onsubmit="handleLiveSearch(event)" style="display: flex; gap: 8px; margin-bottom: 14px; flex-wrap: wrap;">
          <input 
            type="text" 
            id="shelfSearchQuery" 
            class="input-skeuo" 
            placeholder="Nhập tên sách, tác giả hoặc tên phim..." 
            style="flex: 1; min-width: 200px; padding: 8px 12px;"
            required
          >
          <select id="shelfSearchType" class="input-skeuo" style="width: 140px; padding: 8px; cursor: pointer;">
            <option value="BOOK">Sách</option>
            <option value="MOVIE">Phim</option>
          </select>
          <button type="submit" class="btn-skeuo btn-brass" style="padding: 8px 16px; font-size: 13px;">
            ✦ Tìm
          </button>
        </form>

        <div id="searchResultsContainer" style="max-height: 280px; overflow-y: auto; display: flex; flex-direction: column; gap: 10px; padding-right: 4px;">
          <div style="text-align: center; color: #876d54; font-size: 14px; padding: 25px 15px; font-style: italic;">
            Nhập từ khóa tác phẩm vào ô trên để tìm kiếm và xếp trực tiếp vào kệ gỗ này.
          </div>
        </div>
      </div>

    

    </div>
  </div>
<% } %>

<script>
  function switchShelfView(mode, btn) {
    document.querySelectorAll('.segmented-tab').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');

    const v3d = document.getElementById('view3D');
    const vTable = document.getElementById('viewTable');
    if (mode === '3d') {
      v3d.style.display = 'block';
      vTable.style.display = 'none';
    } else {
      v3d.style.display = 'none';
      vTable.style.display = 'block';
    }
  }

  function copyShelfLink() {
    const url = window.location.href;
    navigator.clipboard.writeText(url).then(() => {
      alert('Đã sao chép liên kết giá sách công khai vào bộ nhớ tạm!\nBạn có thể gửi liên kết này cho bạn bè cùng chiêm ngưỡng.');
    }).catch(() => {
      prompt('Sao chép liên kết bên dưới để chia sẻ giá sách:', url);
    });
  }

  function openAddMediaModal() {
    const modal = document.getElementById('addMediaToShelfModal');
    if (modal) modal.classList.add('active');
  }

  function closeAddMediaModal() {
    const modal = document.getElementById('addMediaToShelfModal');
    if (modal) modal.classList.remove('active');
  }

  function switchAddTab(tab) {
    const tabSearchBtn = document.getElementById('tabSearchBtn');
    const tabDirectBtn = document.getElementById('tabDirectBtn');
    const tabSearchSection = document.getElementById('tabSearchSection');
    const tabDirectSection = document.getElementById('tabDirectSection');

    if (tab === 'search') {
      tabSearchBtn.classList.add('active');
      tabDirectBtn.classList.remove('active');
      tabSearchSection.style.display = 'block';
      tabDirectSection.style.display = 'none';
    } else {
      tabDirectBtn.classList.add('active');
      tabSearchBtn.classList.remove('active');
      tabDirectSection.style.display = 'block';
      tabSearchSection.style.display = 'none';
    }
  }

  async function handleLiveSearch(event) {
    event.preventDefault();
    const query = document.getElementById('shelfSearchQuery').value.trim();
    const type = document.getElementById('shelfSearchType').value;
    const container = document.getElementById('searchResultsContainer');

    if (!query) return;

    container.innerHTML = '<div style="text-align: center; color: #876d54; padding: 25px; font-style: italic;">Đang tra cứu dữ liệu...</div>';

    try {
      const res = await fetch('/api/search-media?q=' + encodeURIComponent(query) + '&type=' + encodeURIComponent(type));
      if (!res.ok) throw new Error('Lỗi từ máy chủ: ' + res.status);
      const items = await res.json();

      if (!items || items.length === 0) {
        container.innerHTML = '<div style="text-align: center; color: #876d54; padding: 20px;">Không tìm thấy tác phẩm nào phù hợp với từ khóa.</div>';
        return;
      }

      let html = '';
      items.forEach(item => {
        html += `
          <div style="display: flex; align-items: center; justify-content: space-between; gap: 12px; background: rgba(255,255,255,0.45); border: 1px solid #d4b896; border-radius: 4px; padding: 8px 12px;">
            <div style="display: flex; align-items: center; gap: 10px; flex: 1; min-width: 0;">
              <img src="${item.poster_url || 'https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcSM4Ykql_OXy7qrC4I1_luoiAAPBYozVJFJvp6xJbUB3pbIxqwrbnUm82g&s=10'}" alt="" style="width: 36px; height: 50px; object-fit: cover; border-radius: 2px; border: 1px solid #7c5836; flex-shrink: 0;">
              <div style="min-width: 0;">
                <div style="font-weight: 700; color: #2e1706; font-size: 14px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${item.title}</div>
                <div style="font-size: 12px; color: #6a4b30; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${item.creator || ''} • ${item.release_year || ''}</div>
              </div>
            </div>
            <form action="/shelves/add-item" method="POST" style="margin: 0; flex-shrink: 0;">
              <input type="hidden" name="shelf_id" value="<%= shelf.id %>">
              <input type="hidden" name="media_id" value="${item.id}">
              <input type="hidden" name="media_type" value="${item.media_type}">
              <button type="submit" class="btn-skeuo btn-brass" style="font-size: 12px; padding: 5px 12px; white-space: nowrap;">
                ✦ Xếp Vào Kệ
              </button>
            </form>
          </div>
        `;
      });
      container.innerHTML = html;

    } catch (err) {
      console.error(err);
      container.innerHTML = '<div style="text-align: center; color: #a12b2b; padding: 15px;">Có lỗi xảy ra khi tra cứu. Vui lòng thử lại.</div>';
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('addMediaToShelfModal');
    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeAddMediaModal();
      });
    }
  });
</script>

<%- include('../partials/footer') %>
