<%- include('../partials/header', { title: 'Alexandria Archive - Sảnh Chính Thư Viện Cổ Điển' }) %>
<%- include('../partials/navbar', { currentRoute: 'home' }) %>

<main class="main-wall">
  
  <!-- HERO BANNER: GRAND READING ROOM -->
  <div style="background: linear-gradient(to bottom, rgba(30,16,9,0.92) 0%, rgba(18,9,5,0.95) 100%), url('https://images.unsplash.com/photo-1521587760476-6c12a4b040da?auto=format&fit=crop&w=1200&q=80') center/cover; border: 4px solid #4a2d18; border-radius: 8px; padding: 40px 30px; margin-bottom: 40px; box-shadow: 0 15px 35px rgba(0,0,0,0.9); text-align: center; position: relative;">
    
    <div class="library-stamp" style="margin-bottom: 12px; font-size: 12px; padding: 4px 14px;">
      KHO LƯU TRỮ VĂN HÓA & ĐIỆN ẢNH
    </div>

    <h1 style="font-family: 'Cinzel', serif; font-size: 32px; color: #f4d89e; text-shadow: 0 2px 4px #000; letter-spacing: 2px; margin-bottom: 12px;">
      Nơi Lưu Giữ Những Cuốn Sách & Thước Phim Vĩ Đại
    </h1>

    <p style="font-size: 18px; color: #d2bfa5; max-width: 720px; margin: 0 auto 26px; line-height: 1.6; font-style: italic;">
      "Một cuốn sách hay hay một bộ phim xúc động giống như một cánh cửa mở ra thế giới khác. Hãy xếp chúng ngay ngắn lên kệ gỗ của riêng bạn."
    </p>

    <!-- Quick Search Input Bar -->
    <form action="/search" method="GET" style="max-width: 620px; margin: 0 auto; display: flex; gap: 8px;">
      <input 
        type="text" 
        name="q" 
        class="input-skeuo" 
        placeholder="Tra cứu tên sách, tác giả (Google Books) hoặc tên phim (TMDB)..."
        style="flex: 1;"
      >
      <button type="submit" class="btn-skeuo btn-brass" style="white-space: nowrap; padding: 10px 20px;">
        🔍 Tra Cứu
      </button>
    </form>

    <!-- Quick Auth CTA -->
    <% if (typeof currentUser === 'undefined' || !currentUser) { %>
      <div style="margin-top: 22px; display: flex; gap: 12px; justify-content: center; align-items: center; flex-wrap: wrap;">
        <span style="color: #ecd7b7; font-size: 14px;">✦ Bạn là độc giả mới đến thư viện?</span>
        <a href="/register" class="btn-skeuo btn-brass" style="font-size: 13px; padding: 8px 16px;">✦ Cấp Thẻ Độc Giả (Đăng Ký)</a>
        <a href="/login" class="btn-skeuo" style="font-size: 13px; padding: 8px 14px;">🔑 Đăng Nhập</a>
      </div>
    <% } else { %>
      <div style="margin-top: 22px; display: flex; gap: 12px; justify-content: center; align-items: center; flex-wrap: wrap;">
        <span style="color: #ecd7b7; font-size: 14px;">✦ Chào mừng độc giả <strong><%= currentUser.username %></strong> trở lại!</span>
        <a href="/shelves" class="btn-skeuo btn-brass" style="font-size: 13px; padding: 8px 16px;">📚 Mở Giá Sách Cá Nhân</a>
        <a href="/auth/logout" class="btn-skeuo btn-ruby" style="font-size: 12px; padding: 8px 12px;">🚪 Đăng Xuất</a>
      </div>
    <% } %>
  </div>

  <!-- STATS PLATES -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-bottom: 40px;">
    <div class="brass-plate" style="text-align: center; padding: 12px 20px;">
      <h3 style="font-family: 'Cinzel', serif; font-size: 26px; color: #2e1705; font-weight: 900;">10,000+</h3>
      <p style="font-size: 13px; color: #472d13; text-transform: uppercase; font-weight: 700; letter-spacing: 1px;">Tác Phẩm Toàn Cầu</p>
    </div>
    <div class="brass-plate" style="text-align: center; padding: 12px 20px;">
      <h3 style="font-family: 'Cinzel', serif; font-size: 26px; color: #2e1705; font-weight: 900;"><%= allShelves.length %> Kệ Gỗ</h3>
      <p style="font-size: 13px; color: #472d13; text-transform: uppercase; font-weight: 700; letter-spacing: 1px;">Giá Sách Cá Nhân</p>
    </div>
    <div class="brass-plate" style="text-align: center; padding: 12px 20px;">
      <h3 style="font-family: 'Cinzel', serif; font-size: 26px; color: #2e1705; font-weight: 900;">2 API Nguồn</h3>
      <p style="font-size: 13px; color: #472d13; text-transform: uppercase; font-weight: 700; letter-spacing: 1px;">Google Books & TMDB</p>
    </div>
  </div>

  <!-- SHELF 1: SÁCH NỔI BẬT (NEW YORK TIMES BESTSELLERS) -->
  <div class="section-head-bar">
    <div class="brass-plate">
      <h2>✦ Sách Bán Chạy Trong Tuần (NYT Bestsellers) ✦</h2>
    </div>
    <div style="font-size: 13px; color: #d4b58e; font-style: italic;">
      📚 Danh sách tuyển chọn từ The New York Times
    </div>
  </div>

  <div class="bookshelf-unit wood-oak" style="margin-bottom: 55px;">
    <%- include('../partials/shelf-row', { items: featuredBooks }) %>
  </div>

  <!-- SHELF 2: PHIM THỊNH HÀNH (TRENDING MOVIES) -->
  <div class="section-head-bar">
    <div class="brass-plate">
      <h2>✦ Tuyệt Tác Điện Ảnh Thịnh Hành (Trending Movies) ✦</h2>
    </div>
    <div style="font-size: 13px; color: #d4b58e; font-style: italic;">
      🎬 Danh sách phim từ TMDB Cinema Archive
    </div>
  </div>

  <div class="bookshelf-unit wood-mahogany">
    <%- include('../partials/shelf-row', { items: featuredMovies }) %>
  </div>

  <!-- RECENT REVIEWS SECTION (VINTAGE PARCHMENT CARDS) -->
  <div class="section-head-bar" style="margin-top: 50px;">
    <div class="brass-plate">
      <h2>✦ Ghi Chép & Review Của Độc Giả ✦</h2>
    </div>
  </div>

  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 24px;">
    <% reviews.forEach(review => { %>
      <div class="vintage-card">
        <div class="library-stamp" style="float: right; margin-top: -6px;">ĐÃ ĐỌC / XEM</div>
        <div style="display: flex; gap: 12px; align-items: center; margin-bottom: 12px;">
          <img src="<%= review.user.avatar_url %>" alt="avatar" style="width: 38px; height: 38px; border-radius: 50%; border: 1px solid #7c5836; object-fit: cover;">
          <div>
            <div style="font-weight: 700; color: #381f0d; font-size: 15px;"><%= review.user.username %></div>
            <div style="font-size: 12px; color: #7f664e;"><%= review.created_at %></div>
          </div>
        </div>

        <div class="star-rating">
          <% for(let i = 0; i < Math.floor(review.rating); i++) { %>★<% } %>
          <span style="font-size: 13px; color: #6b4d30; font-weight: 600;">(<%= review.rating %>/5.0)</span>
        </div>

        <p style="font-size: 15px; line-height: 1.6; color: #3d2919; font-style: italic;">
          "<%= review.content %>"
        </p>

        <div style="margin-top: 14px; border-top: 1px dashed #d1c09d; padding-top: 8px; font-size: 12px; color: #7a5f45;">
          Mã định danh: <code><%= review.media_id %></code>
        </div>
      </div>
    <% }) %>
  </div>

</main>

<%- include('../partials/footer') %>
