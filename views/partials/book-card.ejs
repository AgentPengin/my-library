<% 
  let itemUrl = `/${item.media_type === 'BOOK' ? 'books' : 'movies'}/${item.id}`;
  if (typeof currentShelfOwnerId !== 'undefined' && currentShelfOwnerId) {
    itemUrl += `?curator=${currentShelfOwnerId}`;
    if (typeof currentShelfId !== 'undefined' && currentShelfId) {
      itemUrl += `&from_shelf=${currentShelfId}`;
    }
  }
%>

<div class="book-item" data-type="<%= item.media_type %>">
  <a href="<%= itemUrl %>" style="display: block;">
    <% if (item.media_type === 'BOOK') { %>
      <div class="silk-ribbon"></div>
    <% } %>
    
    <div class="book-cover-wrapper">
      <img src="<%= item.poster_url %>" alt="<%= item.title %>" loading="lazy">
      <span class="media-tag <%= item.media_type === 'MOVIE' ? 'movie' : '' %>">
        <%= item.media_type === 'BOOK' ? 'SÁCH' : 'PHIM' %>
      </span>
    </div>
  </a>

  <div class="book-meta">
    <a href="<%= itemUrl %>">
      <div class="title" title="<%= item.title %>"><%= item.title %></div>
    </a>
    <div class="author" title="<%= item.creator %>"><%= item.creator %> (<%= item.release_year %>)</div>

    <!-- Hiển thị Thể loại nổi bật -->
    <% if (item.genres && item.genres.length > 0) { %>
      <div style="font-size: 11px; margin-top: 3px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
        <span style="background: rgba(138, 75, 39, 0.09); border: 1px solid #d4c1a5; border-radius: 2px; padding: 1px 6px; color: #5f4227; font-size: 10px;">
          🏷️ <%= Array.isArray(item.genres) ? item.genres[0] : item.genres %>
        </span>
      </div>
    <% } %>

    <!-- Hiển thị Rating cá nhân của Chủ Kệ (nếu có) -->
    <% if (typeof item.owner_rating !== 'undefined' && item.owner_rating) { %>
      <div class="star-rating" style="font-size: 12px; margin: 4px 0 2px;" title="Chủ giá sách đã chấm <%= item.owner_rating %>/5.0">
        <% for(let s = 1; s <= 5; s++) { %>
          <%= s <= Math.round(item.owner_rating) ? '★' : '☆' %>
        <% } %>
        <span style="font-size: 11px; color: #3b220d; font-weight: 700;">(<%= item.owner_rating %>)</span>
      </div>
    <% } %>

    <!-- Dấu mộc: Chủ kệ đã viết cảm nhận -->
    <% if (item.owner_review_snippet) { %>
      <div style="margin-top: 3px;">
        <span style="font-size: 9px; color: #8e2b10; font-weight: 700; background: rgba(184, 60, 20, 0.1); border: 1px dashed #c05330; border-radius: 3px; padding: 1px 5px; display: inline-block;" title="Có bài viết cảm nhận riêng">
          🔖 ĐÃ GHI CẢM NHẬN
        </span>
      </div>
    <% } %>
    
    <!-- Action Button (Gỡ Khỏi Kệ cho chủ sở hữu, hoặc Thêm Vào Kệ cho khách) -->
    <% if (typeof currentShelfId !== 'undefined' && currentShelfId && typeof isOwner !== 'undefined' && isOwner === true) { %>
      <!-- Nút gỡ khỏi kệ hiện tại trên kệ gỗ 3D (Chỉ chủ kệ mới thấy) -->
      <div style="margin-top: 6px;">
        <form action="/shelves/<%= currentShelfId %>/remove-item" method="POST" style="margin: 0;" onsubmit="return confirm('Bạn có chắc muốn gỡ tác phẩm [<%= item.title %>] khỏi giá sách?');">
          <input type="hidden" name="media_id" value="<%= item.id %>">
          <button type="submit" class="btn-skeuo btn-ruby" style="font-size: 11px; padding: 3px 8px; width: 100%;">
            🗑️ Gỡ Khỏi Kệ
          </button>
        </form>
      </div>
    <% } else { %>
      <!-- Quick Add to shelf action -->
      <div style="margin-top: 6px;">
        <button 
          class="btn-skeuo btn-brass js-open-shelf-modal" 
          style="font-size: 11px; padding: 3px 8px;"
          data-media-id="<%= item.id %>"
          data-media-title="<%= item.title %>">
          + Kệ Sách
        </button>
      </div>
    <% } %>
  </div>
</div>
